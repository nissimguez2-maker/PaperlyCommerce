# ---------------------------------------------------------------------------
# Paperly — environment variables
# Copy this file to `.env.local` and fill in real values.
# The site is fully deployable with these PLACEHOLDER values; payment and the
# Supabase-backed catalog activate automatically once real keys are provided.
# ---------------------------------------------------------------------------

# Public site URL (used for canonicals, hreflang, OG, sitemap).
NEXT_PUBLIC_SITE_URL=https://paperly.netlify.app

# --- Supabase (catalog + orders) -------------------------------------------
# When these are set, the catalog/orders read+write through Supabase.
# When unset, the site falls back to the bundled seed catalog (src/data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key for order writes / webhook reconciliation. NEVER expose client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Payments: Grow / Meshulam (Israeli hosted checkout) -------------------
# Hosted payment page supports credit cards, Bit, and installments (תשלומים).
# Docs: https://grow-il.readme.io  (sandbox + production base URLs differ).
GROW_API_BASE=https://sandbox.meshulam.co.il/api/light/server/1.0
GROW_USER_ID=your-grow-user-id
GROW_PAGE_CODE=your-grow-page-code
GROW_API_KEY=your-grow-api-key
# Shared secret used to validate webhook callbacks from the gateway.
GROW_WEBHOOK_SECRET=change-me

# Number of installment payments to offer at checkout (תשלומים). 1 = single charge.
NEXT_PUBLIC_MAX_INSTALLMENTS=12

# --- Contact / integrations (safe to expose) -------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=972586170698
NEXT_PUBLIC_INSTAGRAM_HANDLE=paper.ly_
NEXT_PUBLIC_PLANNER_EMAIL=sachaguez.mt@gmail.com
